# Jira Dashboard Configuration
# Copy this file to .env and fill in your values

# ============== Jira Connection ==============
# Your Jira instance URL (e.g., https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net

# Your Jira account email
JIRA_EMAIL=your-email@example.com

# Your Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-api-token-here

# ============== Application Settings ==============
# Server port (default: 5000)
PORT=5000

# Enable debug mode (default: false)
FLASK_DEBUG=false

# ============== Demo Mode ==============
# Set to 'true' to use mock data without Jira connection
DEMO_MODE=false
